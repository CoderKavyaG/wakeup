datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// DEVOS MODELS (PHASE 2)
// ==========================================

model Project {
  id                   String   @id @default(uuid())
  name                 String
  description          String   @default("")
  status               String   @default("active") // "planning" | "active" | "completed" | "stale"
  tags                 String[] @default([])
  githubUrl            String?
  liveUrl              String?
  folderPath           String?
  feedback             Json     @default("[]")
  
  // Project Intelligence & Developer Memory Fields
  summary              String?  @db.Text
  architectureNotes    String?  @db.Text
  deploymentInfo       String?  @db.Text
  screenshots          String[] @default([])
  techStack            String[] @default([])
  resumeBullet         String?  @db.Text
  interviewNotes       String?  @db.Text
  projectHealth        Float    @default(100.0)
  momentumScore        Float    @default(0.0)
  nextAction           String?
  completionPercentage Float    @default(0.0)

  lastSyncedAt         DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  
  health               Int?
  healthSignals        String?  // JSON array of signal strings

  phase                String   @default("idea")  // "launched"|"in_development"|"sketching"|"idea"
  coverImageUrl        String?
  ogImageUrl           String?

  // Relations (Phase 5)
  memories             Memory[]
  projectMemory        ProjectMemory?
  commits              Commit[]
  links                ProjectLink[]
  notes                Note[]
  ideas                Idea[]
  mediaItems           MediaItem[]
  projectTasks         ProjectTask[]
  captureMessages      CaptureMessage[]
  userId               String?
  user                 User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vercelProjectId      String?
}

model Commit {
  id        String   @id @default(cuid())
  repoName  String
  sha       String   @unique
  message   String
  date      DateTime
  url       String?
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now())
}

model ProjectLink {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label      String
  url        String
  type       String    // 'frontend' | 'backend' | 'database' | 'storage' | 'monitoring' | 'logs' | 'other'
  lastStatus Int?      // HTTP status code from last ping
  lastPinged DateTime?
  createdAt  DateTime  @default(now())
}

model Task {
  id        String   @id @default(uuid())
  title     String
  completed Boolean  @default(false)
  priority  String   @default("medium") // "low" | "medium" | "high"
  dueDate   String?
  projectId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Note {
  id        String   @id @default(uuid())
  content   String   @db.Text
  projectId String?
  category  String?  // 'feedback' | 'bug' | 'idea' | 'note'
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Url {
  id        String   @id @default(uuid())
  label     String
  url       String
  category  String   @default("other") // "docs" | "deployment" | "github" | "other"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LayoutState {
  id        String   @id @default("global-layout")
  layouts   Json     // Persisted grid coordinates
  widgets   Json     // Enabled widgets list
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GithubCache {
  id        String   @id @default("global-cache")
  data      Json
  updatedAt DateTime @updatedAt
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// THEDAILYDEV SIBLING MODELS (SAFEKEEPING)
// ==========================================

model Trend {
  id              Int          @id @default(autoincrement())
  title           String
  description     String?
  url             String       @unique
  source          String       // e.g., "Reddit", "HackerNews", "Dev.to"
  category        String       // e.g., "AI", "Dev", "General"
  engagementScore Int          @default(0)
  upvotes         Int          @default(0)
  comments        Int          @default(0)
  originalId      String?      @unique
  publishedAt     DateTime
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  savedTrends     SavedTrend[]

  @@index([source, category])
  @@index([engagementScore(sort: Desc)])
  @@index([url])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String    // bcrypt hashed (no longer optional)
  googleId      String?   @unique
  role          String    @default("user") // "user", "admin"
  avatar        String?
  vercelToken   String?   // Vercel API Integration Token
  createdAt     DateTime  @default(now())

  // Relations
  projects      Project[]
  tasks         Task[]
  notes         Note[]
  urls          Url[]
  layouts       LayoutState[]
  insights      AIInsight[]
  githubCaches  GithubCache[]
  savedTrends   SavedTrend[]
  socialDrafts  SocialDraft[]
  ideas           Idea[]
  mediaItems      MediaItem[]
  captureMessages CaptureMessage[]
  projectTasks    ProjectTask[]
}

model SavedTrend {
  id          Int       @id @default(autoincrement())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  trend       Trend?    @relation(fields: [trendId], references: [id], onDelete: Cascade)
  trendId     Int?
  title       String
  url         String    @unique(map: "SavedTrend_userId_url_key")
  source      String
  description String?
  image       String?
  author      String?
  publishedAt DateTime?
  savedAt     DateTime  @default(now())

  @@index([userId])
  @@index([trendId])
}

// ==========================================
// COGNITIVE LAYER (PHASE 5)
// ==========================================

model Memory {
  id           String      @id @default(uuid())
  // Core content
  content      String      @db.Text
  sourceType   String      // "note" | "commit" | "readme" | "task" | "timeline"
  sourceId     String?     // Link to original source
  // Embeddings & search
  embedding    Float[]     @default([])  // OpenAI embedding array (1536 dims)
  // Metadata
  projectId    String?
  project      Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  metadata     Json        // { author, url, commitHash, etc }
  // Lifecycle
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  
  @@index([sourceType])
  @@index([projectId])
}

model ProjectMemory {
  id           String      @id @default(uuid())
  projectId    String      @unique
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Aggregated insights
  summary      String      @db.Text @default("")
  recentEvents String[]    @default([])
  incidents    String[]    @default([])
  architecture String      @db.Text @default("")
  // Stats
  totalMemories Int        @default(0)
  lastIndexed  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model AIInsight {
  id        String   @id @default(cuid())
  type      String   // 'daily_brief' | 'stale_warning' | 'overdue' | 'commit_summary'
  content   String
  metadata  Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SocialDraft {
  id        String   @id @default(cuid())
  platform  String   // 'twitter' | 'linkedin'
  content   String   @db.Text
  status    String   @default("draft") // 'draft' | 'published'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Idea {
  id          String   @id @default(cuid())
  projectId   String?  // null = global idea board, not tied to a project
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  content     String   // The idea text
  source      String   @default("manual") // "manual" | "telegram" | "whatsapp" | "cockpit"
  status      String   @default("raw")    // "raw" | "validated" | "building" | "shelved"
  starred     Boolean  @default(false)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MediaItem {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        String   // "image" | "screenshot" | "sketch" | "chat_export" | "link_preview"
  url         String   // either a stored path or external URL
  thumbnailUrl String? // auto-generated or OG image
  title       String?
  description String?
  mimeType    String?
  sizeBytes   Int?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model CaptureMessage {
  id          String   @id @default(cuid())
  source      String   // "telegram" | "whatsapp"
  rawText     String   // original message
  classified  String?  // "task" | "idea" | "note" — filled after AI classification
  projectId   String?  // filled after @mention detection
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  processed   Boolean  @default(false)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model ProjectTask {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  completed   Boolean  @default(false)
  priority    String   @default("medium") // "urgent" | "high" | "medium" | "low"
  dueDate     DateTime?
  milestone   String?  // group tasks under milestone labels
  order       Int      @default(0)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

